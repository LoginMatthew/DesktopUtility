<UserControl x:Class="DesktopUtility.Views.MonitoringView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DesktopUtility.PresentationControls" xmlns:views="clr-namespace:DesktopUtility.Views">
 <UserControl.Resources>
  <DataTemplate x:Key="MetricAlertTemplate">
   <Viewbox Width="17" Height="17" Margin="7,0,0,0" VerticalAlignment="Center"
            ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
    <Viewbox.Style>
     <Style TargetType="Viewbox">
      <Style.Triggers>
       <DataTrigger Binding="{Binding}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Viewbox.Style>
    <Grid Width="20" Height="20">
     <Path Data="M 10,1 L 19,18 H 1 Z" StrokeThickness="1.2" StrokeLineJoin="Round">
      <Path.Style>
       <Style TargetType="Path">
        <Setter Property="Fill" Value="#FFAB55" />
        <Setter Property="Stroke" Value="#FFAB55" />
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsCritical}" Value="True">
          <Setter Property="Fill" Value="#FF626D" />
          <Setter Property="Stroke" Value="#FF626D" />
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Path.Style>
     </Path>
     <Path Data="M 10,7 V 12 M 10,15 V 15.2" Stroke="#201419" StrokeThickness="2"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid>
   </Viewbox>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,10,0" MaxWidth="1000">
   <CheckBox Content="{Binding Words[MonitoringEnabled]}" IsChecked="{Binding Enabled, Mode=TwoWay}"
             FontSize="17" FontWeight="SemiBold" />
   <WrapPanel Margin="0,3,0,3">
    <TextBlock Text="{Binding Words[MonitoringViewMode]}" VerticalAlignment="Center" Margin="0,0,10,6" />
    <ComboBox ItemsSource="{Binding DisplayModes}" SelectedIndex="{Binding DisplayMode, Mode=TwoWay}"
              AutomationProperties.Name="{Binding Words[MonitoringViewMode]}" MinWidth="145" />
   </WrapPanel>
   <TextBlock Text="{Binding Words[MonitoringScope]}" TextWrapping="Wrap" Margin="0,2,0,14" />
   <StackPanel>
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
       <DataTrigger Binding="{Binding ShowTemperatureDriverLink}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </StackPanel.Style>
    <Button Content="{Binding Words[TemperatureDriverPage]}" Click="OpenTemperatureDriverPage" HorizontalAlignment="Left" />
    <TextBlock x:Name="TemperatureDriverNotice" TextWrapping="Wrap" />
   </StackPanel>
   <ItemsControl ItemsSource="{Binding Cards}">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate>
      <UniformGrid Columns="2" />
     </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource ChromeStroke}"
              BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,10,10" MinHeight="128">
       <StackPanel>
        <DockPanel>
         <ContentControl DockPanel.Dock="Right" Content="{Binding LoadAlert}"
                         ContentTemplate="{StaticResource MetricAlertTemplate}" VerticalContentAlignment="Center" />
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
        </DockPanel>
        <CheckBox Content="{Binding ToggleLabel}" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <Expander DataContext="{Binding DiskFilter}" Header="{Binding Words[DiskSelection]}"
                  Foreground="{DynamicResource AppText}" Margin="0,2,0,4">
         <Expander.Style>
          <Style TargetType="Expander">
           <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
             <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Expander.Style>
         <StackPanel Margin="8,2,0,4">
          <CheckBox Content="{Binding Words[MonitorAllDisks]}" IsChecked="{Binding AllDrives, Mode=TwoWay}" />
          <ItemsControl ItemsSource="{Binding Drives}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
             </CheckBox>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Expander>
        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Accent}" FontSize="23"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay, TargetNullValue=0}"
                     Height="5" Margin="0,8,0,4" Foreground="{DynamicResource Accent}" Background="{DynamicResource ControlSurface}"
                     AutomationProperties.Name="{Binding Title}">
         <ProgressBar.Style>
          <Style TargetType="ProgressBar">
           <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.ShowCharts, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
             <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Percentage}" Value="{x:Null}">
             <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </ProgressBar.Style>
        </ProgressBar>
        <ItemsControl ItemsSource="{Binding Trends}" Margin="0,4,0,0">
         <ItemsControl.Style>
          <Style TargetType="ItemsControl">
           <Setter Property="Visibility" Value="Collapsed" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.ShowCharts, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
             <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </ItemsControl.Style>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <StackPanel Margin="0,4,0,0">
            <DockPanel>
             <TextBlock Text="{Binding Scale}" DockPanel.Dock="Right" Margin="8,0,0,0" />
             <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            </DockPanel>
            <controls:MetricHistoryChart Samples="{Binding Samples}" SecondarySamples="{Binding SecondarySamples}"
                                         Maximum="{Binding Maximum}" Height="52" SecondaryBrush="{DynamicResource AppText}"
                                         LineBrush="{DynamicResource Accent}" GridBrush="{DynamicResource ChromeStroke}"
                                         AutomationProperties.Name="{Binding Label}" />
            <WrapPanel Margin="0,0,0,4">
             <WrapPanel.Style>
              <Style TargetType="WrapPanel">
               <Style.Triggers>
                <DataTrigger Binding="{Binding PrimaryLabel}" Value="{x:Null}">
                 <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </WrapPanel.Style>
             <TextBlock Text="━" Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
             <TextBlock Text="{Binding PrimaryLabel}" Margin="0,0,12,0" />
             <TextBlock Text="┄" Margin="0,0,5,0" />
             <TextBlock Text="{Binding SecondaryLabel}" />
            </WrapPanel>
           </StackPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <ItemsControl ItemsSource="{Binding Volumes}">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <DockPanel Margin="0,2,0,2">
            <ContentControl DockPanel.Dock="Right" Content="{Binding Alert}"
                            ContentTemplate="{StaticResource MetricAlertTemplate}" VerticalContentAlignment="Center" />
            <StackPanel>
             <TextBlock Text="{Binding Capacity}" TextWrapping="Wrap" />
             <TextBlock Text="{Binding Rates}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
           </DockPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <views:FpsMonitoringView DataContext="{Binding Fps}" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
